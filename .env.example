# Cream Soda local runtime (legacy REPOBRAIN_* names remain supported)
# Absolute repo root used by the local UI when it is launched from apps/desktop-web.
REPOBRAIN_PROJECT_ROOT=

# Optional local runtime overrides. Leave blank to use the repo-local .repobrain defaults.
REPOBRAIN_HOME=
REPOBRAIN_CONFIG_PATH=
REPOBRAIN_ALLOWED_ROOTS=
REPOBRAIN_STORAGE_PATH=

# Reserved for future HTTP MCP mode. Stdio MCP does not bind a port.
REPOBRAIN_MCP_PORT=4827

# Optional provider selection. Missing providers are safe; retrieval falls back to local exact/keyword mode.
REPOBRAIN_EMBEDDING_PROVIDER=
REPOBRAIN_RERANKER_PROVIDER=
REPOBRAIN_MODEL_PROVIDER=
REPOBRAIN_VECTOR_PROVIDER=

# Optional provider secrets. Do not commit real values.
REPOBRAIN_OPENAI_API_KEY=
REPOBRAIN_ANTHROPIC_API_KEY=
REPOBRAIN_LOCAL_MODEL_BASE_URL=
