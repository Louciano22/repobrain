{
  "name": "@repobrain/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./project-config": {
      "types": "./dist/project-config.d.ts",
      "default": "./dist/project-config.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@repobrain/core": "workspace:*",
    "@repobrain/shared-types": "workspace:*"
  }
}
